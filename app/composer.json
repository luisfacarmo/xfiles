{
    "name": "luiscarmo/xfiles",
    "description": "Photo vault for Nextcloud — lock, hide, and protect sensitive images",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "autoload": {
        "psr-4": {
            "OCA\\XFiles\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\XFiles\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "nextcloud/ocp": "^28"
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml",
        "lint": "php -l lib/",
        "stan": "phpstan analyse --configuration=phpstan.neon.dist"
    }
}
